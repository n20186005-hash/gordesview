{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gordesview",
  "main": "worker.js",
  "compatibility_date": "2026-11-02",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "previews": {}
}
